ui_print "Cloning NoMount Source"
git clone https://github.com/maxsteeel/nomount/ -b master --depth=1
ui_print "Repo Cloned"
ui_print "Copy nomount kernel source to kernel source"
mkdir ${GITHUB_WORKSPACE}/$source_name/drivers/nomount
cp ${GITHUB_WORKSPACE}/nomount/kernel/src/* ${GITHUB_WORKSPACE}/$source_name/drivers/nomount
ui_print "Copied"
ui_print "bashing setup.sh"
cd ${GITHUB_WORKSPACE}/$source_name/
bash ${GITHUB_WORKSPACE}/nomount/kernel/setup.sh 
